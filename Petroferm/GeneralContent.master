<%@ Master Language="VB" CodeFile="GeneralContent.master.vb" Inherits="GeneralContent" %>
<%@ Register Src="controls/AdobeLink.ascx" TagName="AdobeLink" TagPrefix="uc2" %>
<%@ Register Src="controls/Login.ascx" TagName="Login" TagPrefix="uc1" %>
<html>
<head id="Head1" runat="server">
    <title>Welcome to Petroferm Inc.</title>
    <LINK href="web/files/scripts/style.css" type="text/css" rel="stylesheet">
    <LINK href="web/files/scripts/homelayers.css" type="text/css" rel="stylesheet">
    <LINK href="web/files/scripts/nav.css" type="text/css" rel="stylesheet">
</head>
<script type="text/javascript">
<!-- #include virtual="web/files/scripts/findDom.js" -->
<!-- #include virtual="web/files/scripts/effects.js" -->
</script>
<script type="text/javascript">
if (isLayers) {
    origWidth = innerWidth;
    origHeight = innerHeight;						
    onresize = reDo;
}
//CSS window resize fix for NS 4.x
function reDo() {
    if (innerWidth != origWidth || innerHeight != origHeight) location.reload();
}
</script>
<body id="MasterBody" runat="server" bgcolor="#0097B4" leftmargin="0" topmargin="10" marginwidth="0" marginheight="10">
    <form id="form1" runat="server">
    <table border="0" width="797" cellspacing="0" cellpadding="1" align="center" bgcolor="#FFFFFF">
	    <tr>
		    <td>
                <a name="TOP"></a>
                <!-- Begin Logo/Nav Table -->
                <table border="0" width="797" cellspacing="0" cellpadding="0" align="center" bgcolor="#FFFFFF" ID="Table1">
	                <tr bgcolor="#E3E3D1">
		                <td width="625" height="75">
		                    &nbsp;<a id="MasterLogoHref" runat="server"></a>
		                </td>
		                <td valign="bottom" style="width: 172px" id="MasterSearchContainer" runat="server">
                            <table border="0" width="155" cellspacing="0" cellpadding="0" align="left" ID="Table2">
	                            <tr>
                                    <td style="padding:0 0 3 0; width: 156px;">
                                        <asp:TextBox ID="txtsearch" runat="server" style="width:80px;border-style:solid;border-width:1;border-color:#666;font-family:tahoma;font-size:11px;" />
                                        <asp:Button ID="btnSimpleSearch" runat="server" Text="Search" CssClass="smallBlueCaps" style="border-style:solid;border-width:1px;border-color:black;" />
                                        <br /><a id="MasterAdvancedSearch" runat="server">Advanced Search</a>
                                    </td>	                            
	                            </tr> 	                            
                                <tr valign="middle" id="RegionContainer" runat="server">
                                    <td style="width: 156px">
                                        <table border="0" width="155" cellspacing="0" cellpadding="0" align="left" ID="Table3">
                                            <tr><td align="left" style="padding-bottom:5;">
                                                <asp:DropDownList ID="ddlRegion" runat="server" AutoPostBack="True" CssClass="text" />&nbsp;<asp:Image ID="imgRegion" runat="server" ImageAlign="AbsMiddle" />
                                            </td></tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
	                <tr>
		                <td colspan="2" height="1" bgcolor="#FFFFFF"></td>
	                </tr>
	                <tr>
		                <td colspan="2" height="44" bgcolor="#74BBCE" width="797" id="MasterTopMenu" runat="server"></td>                		
	                </tr>
                </table>
			    <table border="0" width="797" cellspacing="0" cellpadding="0" align="center" bgcolor="#FFFFFF">
            	    <tr>
            	        <td colspan="8" bgcolor="#FFFFFF" style="height: 1px"></td>
            	    </tr>
	                <tr valign="top" bgcolor="#FFFFFF">
		                <td width="164" rowspan="3" bgcolor="#C3C3B0">
                            <asp:PlaceHolder ID="SideNavigation" runat="server" /> 
                            <uc1:Login ID="Login1" runat="server" />
                            <uc2:AdobeLink ID="AdobeLink1" runat="server" />
                        </td>
                        <td width="1" rowspan="2" bgcolor="#FFFFFF"><img src="web/files/images/misc/spacer.gif" width="1" alt="Petroferm Inc." border="0"></td>
                        <td width="602" height="100%">
							<table border="0" width="100%" cellspacing="0" cellpadding="0" height="100%">
	                            <tr><td colspan="6" height="1" bgcolor="#FFFFFF"><img src="web/files/images/misc/spacer.gif" height="1" alt="Petroferm Inc." border="0"></td></tr>
	                            <tr valign="top" bgcolor="#FFFFFF">
		                            <td width="30" style="height: 250px"><img src="web/files/images/misc/spacer.gif" alt="Petroferm Inc." width="30" height="1" border="0"></td>
		                            <td style="padding-top:16;padding-bottom:10;padding-right:20;height:250px;" colspan="5">
                                        <asp:ContentPlaceHolder ID="MasterBodyContent" runat="server"></asp:ContentPlaceHolder>
                                    </td>
	                            </tr>
                            </table>						
		                </td>
	                </tr>
	                <tr valign="bottom">
	                    <td bgcolor="#FFFFFF" valign="bottom" colspan="2" height="100%">
                            <table width="100%" height=100% bgcolor="#FFFFFF" cellpadding="0" cellspacing="0" border="0">
                                <tr>
		                            <td style="padding-left:30px;padding-bottom:2px;" width="632">
		                                <a id="MasterTerms" runat="server" class="small" onMouseOver="window.status='Review the website Terms & Conditions'; return true;" onMouseOut="window.status=' '; return true;" >Terms & Conditions</a>
		                                &nbsp;&nbsp;<span class="bodySmall" id="MasterCopyright" runat="server"></span>
		                            </td>
                            	</tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>                      
    </form>
</body>
</html>
